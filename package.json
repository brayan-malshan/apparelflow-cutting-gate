{
  "name": "apparelflow-cutting-gate",
  "version": "1.0.0",
  "private": true,
  "description": "ApparelFlow ERP - Cutting Operations & Gatekeeper Verification Terminal",
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/src/index.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm run dev --prefix client",
    "test": "vitest run",
    "seed": "node server/src/seed-cli.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.4"
  }
}
